!/index.html
!/site.css
!/site.js
!/share.jpg
!/assets/
/assets/*
!/assets/system.css
!/assets/system.js
!/assets/ui/
/assets/ui/*
!/assets/ui/cards.css
!/assets/motion/
/assets/motion/*
!/assets/motion/motion.css
!/assets/motion/motion.js
!/assets/img/
/assets/img/*
!/assets/img/close-team.webp
!/assets/img/emblem.png
!/assets/img/favicon.png
!/assets/img/film-augusta.webp
!/assets/img/hero-blur.webp
!/assets/img/hero-full.webp
